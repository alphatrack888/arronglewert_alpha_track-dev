# =============================================================================
# Local reference for GitHub Actions secrets (mobile Flutter repo)
# =============================================================================
# This file is NOT loaded by Flutter, Fastlane, or GitHub Actions automatically.
# Use it as a checklist: copy each populated value into the matching GitHub
# repository secret (Settings → Secrets and variables → Actions) or into the
# `mobile-release` environment.
#
# Keep your real values in `.env` (gitignored). Base64 is encoding, not encryption.
# Never commit `.env` or paste secret contents into chat.
#
# Operator guide: MOBILE_CI_CD.md (port from legacy with CI in Phase M2).
# =============================================================================

# --- Android release signing (Mobile release → prepare_release.py android) ---
# Base64 of the production upload keystore (upload-keystore.jks).
ANDROID_KEYSTORE_BASE64=

# Keystore entry alias (must match the key inside the .jks file).
ANDROID_KEY_ALIAS=

# Password for the keystore file itself.
ANDROID_STORE_PASSWORD=

# Password for the private key entry (often same as store password).
ANDROID_KEY_PASSWORD=

# --- Android Firebase (CI writes android/app/google-services.json) ---
# Base64 of google-services.json for com.marcgelwertz.alphatrack (not the legacy
# com.marc.alphatrack client unless you intentionally still use that package).
ANDROID_GOOGLE_SERVICES_JSON_BASE64=

# --- Google Play upload (only when Mobile release “Upload” is enabled) ---
# Full JSON of the Play Console service account (plain text, NOT base64).
# Must be authorized for this app’s internal/testing releases — not Firebase Admin.
PLAY_SERVICE_ACCOUNT_JSON=

# --- iOS (deferred — not required until Android Play internal is done; migration M7) ---
# --- iOS code signing (Mobile release → fastlane ios build) ---
# Base64 of Apple Distribution .p12 (certificate + private key).
IOS_DISTRIBUTION_P12_BASE64=

# Export password for the .p12 (empty string if exported without password).
IOS_DISTRIBUTION_P12_PASSWORD=

# Base64 of App Store distribution .mobileprovision (push enabled if using FCM).
IOS_PROVISIONING_PROFILE_BASE64=

# Apple Developer team ID (10-character; matches Xcode Runner target).
APPLE_TEAM_ID=

# --- iOS Firebase (CI writes ios/Runner/GoogleService-Info.plist) ---
# Base64 of GoogleService-Info.plist; bundle ID must match Xcode + provisioning.
IOS_GOOGLE_SERVICE_INFO_PLIST_BASE64=

# --- App Store Connect API (TestFlight upload when “Upload” is enabled) ---
# Key ID from App Store Connect → Users and Access → Integrations → Keys.
APP_STORE_CONNECT_KEY_ID=

# Issuer ID for the same App Store Connect API key.
APP_STORE_CONNECT_ISSUER_ID=

# Base64 of the App Store Connect .p8 private key file.
APP_STORE_CONNECT_KEY_BASE64=

# =============================================================================
# Flutter compile-time overrides (NOT .env — use dart-define on flutter run/build)
# =============================================================================
# SOCKET_URL=https://your-host:5000/
#   Override Socket.IO host for local backend (default: production API host).
#   See lib/core/api_urls/api_urls.dart → socketUrl.
#
# DEMO_MODE=true
#   Forces demo data + skip login in release builds (App Store reviewer only).
#   Normal release builds must NOT set this. See lib/utils/demo_data/demo_data.dart.
#
# Example:
#   flutter run --dart-define=SOCKET_URL=http://192.168.1.10:5000/
#   flutter build apk --release --dart-define=DEMO_MODE=true
# =============================================================================

# =============================================================================
# Local Android signing only (NOT GitHub secrets — android/key.properties)
# =============================================================================
# storePassword=
# keyPassword=
# keyAlias=upload
# storeFile=../upload-keystore.jks
# Used by Gradle for local release builds; CI uses ANDROID_* secrets above instead.
# =============================================================================
